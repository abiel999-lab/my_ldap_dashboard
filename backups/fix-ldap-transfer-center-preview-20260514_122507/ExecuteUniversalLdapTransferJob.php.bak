<?php

namespace App\Jobs\Operations;

use App\Models\Operations\OperationJob;
use App\Models\Operations\UniversalLdapTransferBatch;
use App\Services\Operations\UniversalLdapTransferService;
use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Foundation\Queue\Queueable;
use Throwable;

class ExecuteUniversalLdapTransferJob implements ShouldQueue
{
    use Queueable;

    public int $tries = 1;

    public int $timeout = 1800;

    public function __construct(
        public int $operationJobId,
        public int $transferBatchId,
    ) {
        $this->onQueue('operations');
    }

    public function handle(UniversalLdapTransferService $service): void
    {
        $job = OperationJob::query()->findOrFail($this->operationJobId);
        $batch = UniversalLdapTransferBatch::query()->findOrFail($this->transferBatchId);

        $job->forceFill([
            'status' => 'running',
            'started_at' => now(),
        ])->save();

        $batch->forceFill([
            'status' => 'running',
            'operation_job_id' => $job->id,
            'started_at' => now(),
        ])->save();

        $result = $service->transfer($batch, $job);

        if (! $result['ok']) {
            $batch->forceFill([
                'status' => 'failed',
                'message' => $result['message'],
                'failed_entries' => 1,
                'finished_at' => now(),
            ])->save();

            $job->forceFill([
                'status' => 'failed',
                'message' => $result['message'],
                'failed_items' => 1,
                'finished_at' => now(),
            ])->save();

            return;
        }

        $batch->forceFill([
            'status' => 'success',
            'message' => $result['message'],
            'total_entries' => $result['total_entries'],
            'planned_entries' => $result['planned_entries'],
            'transferred_entries' => $result['transferred_entries'],
            'failed_entries' => $result['failed_entries'],
            'output_path' => $result['output_path'],
            'output_size_bytes' => $result['output_size_bytes'],
            'output_hash' => $result['output_hash'],
            'finished_at' => now(),
        ])->save();

        $job->forceFill([
            'status' => 'success',
            'total_items' => $result['total_entries'],
            'processed_items' => $result['planned_entries'],
            'success_items' => $result['planned_entries'],
            'failed_items' => $result['failed_entries'],
            'finished_at' => now(),
            'metadata' => array_merge((array) $job->metadata, $result),
        ])->save();
    }

    public function failed(Throwable $exception): void
    {
        UniversalLdapTransferBatch::query()
            ->whereKey($this->transferBatchId)
            ->update([
                'status' => 'failed',
                'message' => $exception->getMessage(),
                'finished_at' => now(),
            ]);

        OperationJob::query()
            ->whereKey($this->operationJobId)
            ->update([
                'status' => 'failed',
                'message' => $exception->getMessage(),
                'finished_at' => now(),
            ]);
    }
}
