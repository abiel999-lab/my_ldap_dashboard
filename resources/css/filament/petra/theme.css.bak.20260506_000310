/* Sidebar pin/hover behavior (desktop) */
.spms-sidebar-pin-toggle {
    display: none;
    margin-bottom: 0.75rem;
}

.spms-sidebar-pin-toggle--sidebar {
    display: none;
    margin-bottom: 0.5rem;
    margin-left: -0.6rem;
    justify-content: flex-start;
}

.spms-sidebar-pin-toggle--sidebar .spms-sidebar-pin-toggle__btn {
    width: 2.5rem !important;
    min-width: 2.5rem;
    max-width: 2.5rem;
    height: 2.5rem !important;
    min-height: 2.5rem;
    max-height: 2.5rem;
    flex: 0 0 2.5rem;
}

@media (min-width: 1024px) {
    .spms-sidebar-pin-toggle {
        display: block;
    }

    .spms-sidebar-pin-toggle--sidebar {
        display: flex;
    }
}

/* Reduce default large sidebar vertical gap */
.fi-sidebar-nav {
    row-gap: 0.75rem !important;
}

.fi-sidebar-nav-groups {
    row-gap: 0.75rem !important;
}

.spms-sidebar-pin-toggle__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    border: 1px solid #d1d5db;
    background: #ffffff;
    color: #1f2937;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    transform: none !important;
}

.spms-sidebar-pin-toggle__btn.fi-icon-btn {
    margin: 0;
}

.spms-sidebar-pin-toggle__btn .fi-icon {
    width: 1.125rem;
    height: 1.125rem;
}

.spms-sidebar-pin-toggle__btn:active,
.spms-sidebar-pin-toggle__btn:focus,
.spms-sidebar-pin-toggle__btn:focus-visible {
    transform: none !important;
}

.spms-sidebar-pin-toggle__btn:hover {
    border-color: #94a3b8;
    background: #f8fafc;
}

.spms-sidebar-pin-toggle__icon {
    width: 1.125rem;
    height: 1.125rem;
}

.spms-sidebar-pin-toggle__hint {
    margin-top: 0.375rem;
    font-size: 0.72rem;
    line-height: 1;
    color: #6b7280;
}

.spms-sidebar-pin-toggle__state {
    display: none;
}

html[data-sidebar-pinned="1"] .spms-sidebar-pin-toggle__state--on {
    display: inline;
    color: #047857;
    font-weight: 600;
}

html[data-sidebar-pinned="0"] .spms-sidebar-pin-toggle__state--off,
html:not([data-sidebar-pinned]) .spms-sidebar-pin-toggle__state--off {
    display: inline;
    color: #b91c1c;
    font-weight: 600;
}

html[data-sidebar-pinned="1"] .spms-sidebar-pin-toggle__btn {
    border-color: #10b981;
    background: #ecfdf5;
    color: #047857;
}

html[data-sidebar-pinned="1"] .spms-sidebar-pin-toggle__btn::after {
    content: '';
    position: absolute;
    top: 4px;
    right: 4px;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #10b981;
}

html[data-sidebar-pinned="0"] .spms-sidebar-pin-toggle__btn::after,
html:not([data-sidebar-pinned]) .spms-sidebar-pin-toggle__btn::after {
    content: '';
    position: absolute;
    top: 4px;
    right: 4px;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #ef4444;
}

.dark .spms-sidebar-pin-toggle__btn {
    border-color: #475569;
    background: linear-gradient(180deg, #1f2937 0%, #111827 100%);
    color: #e2e8f0;
    box-shadow: 0 6px 20px rgba(2, 6, 23, 0.45);
}

.dark .spms-sidebar-pin-toggle__btn:hover {
    border-color: #64748b;
    background: linear-gradient(180deg, #334155 0%, #1f2937 100%);
    color: #f8fafc;
}

.dark .spms-sidebar-pin-toggle__btn:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
}

html.dark[data-sidebar-pinned="1"] .spms-sidebar-pin-toggle__btn,
html.dark[data-sidebar-pinned="1"] .spms-sidebar-pin-toggle__btn:hover {
    border-color: #10b981;
    background: linear-gradient(180deg, rgba(16, 185, 129, 0.28) 0%, rgba(5, 150, 105, 0.22) 100%);
    color: #bbf7d0;
}

html.dark[data-sidebar-pinned="0"] .spms-sidebar-pin-toggle__btn,
html.dark[data-sidebar-pinned="0"] .spms-sidebar-pin-toggle__btn:hover {
    border-color: #f87171;
    background: linear-gradient(180deg, rgba(248, 113, 113, 0.18) 0%, rgba(239, 68, 68, 0.14) 100%);
    color: #fecaca;
}

@media (min-width: 1024px) {
    html .fi-main-sidebar {
        transition: width var(--default-transition-duration, 0.15s) var(--default-transition-timing-function, cubic-bezier(0.4, 0, 0.2, 1));
    }

    html .fi-main-sidebar .fi-sidebar-item-btn {
        justify-content: flex-start;
    }

    html .fi-main-sidebar .fi-sidebar-item-icon {
        width: 1.25rem !important;
        height: 1.25rem !important;
        min-width: 1.25rem;
        min-height: 1.25rem;
    }

    html[data-sidebar-pinned="0"] .fi-main-sidebar {
        width: 5.25rem !important;
        min-width: 5.25rem;
    }

    html[data-sidebar-pinned="0"] .fi-sidebar-main-label,
    html[data-sidebar-pinned="0"] .fi-sidebar-item-label,
    html[data-sidebar-pinned="0"] .fi-main-sidebar .fi-sidebar-item-badge-ctn,
    html[data-sidebar-pinned="0"] .fi-main-sidebar .fi-sidebar-group-label,
    html[data-sidebar-pinned="0"] .fi-main-sidebar .fi-sidebar-group-dropdown-trigger-btn,
    html[data-sidebar-pinned="0"] .fi-main-sidebar .fi-sidebar-nav .fi-global-search {
        display: none !important;
    }

    html[data-sidebar-pinned="0"] .fi-main-sidebar .fi-sidebar-nav {
        display: flex !important;
    }
}

