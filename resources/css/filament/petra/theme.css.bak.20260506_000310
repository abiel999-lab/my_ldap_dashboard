/* ============================================================
   PETRA LDAP DASHBOARD - LAYOUT SEPARATION
   Purpose:
   - Make sidebar visually different from main content
   - Keep admin UI full Filament
   - Do not override vendor files
   ============================================================ */

:root {
    --petra-sidebar-bg: #0f1f3d;
    --petra-sidebar-bg-soft: #14294f;
    --petra-sidebar-border: rgba(148, 163, 184, 0.22);
    --petra-sidebar-text: #dbeafe;
    --petra-sidebar-muted: #94a3b8;
    --petra-sidebar-active-bg: #1e40af;
    --petra-sidebar-active-border: #38bdf8;

    --petra-topbar-bg: #ffffff;
    --petra-topbar-border: #e2e8f0;

    --petra-content-bg: #f1f5f9;
    --petra-content-card-bg: #ffffff;
}

.dark {
    --petra-sidebar-bg: #020617;
    --petra-sidebar-bg-soft: #0f172a;
    --petra-sidebar-border: rgba(148, 163, 184, 0.18);
    --petra-sidebar-text: #e2e8f0;
    --petra-sidebar-muted: #94a3b8;
    --petra-sidebar-active-bg: rgba(59, 130, 246, 0.22);
    --petra-sidebar-active-border: #38bdf8;

    --petra-topbar-bg: #0b1220;
    --petra-topbar-border: rgba(148, 163, 184, 0.18);

    --petra-content-bg: #111827;
    --petra-content-card-bg: #0f172a;
}

/* Main page background */
.fi-body,
.fi-layout,
.fi-main,
.fi-page {
    background: var(--petra-content-bg) !important;
}

/* Topbar should feel separate from sidebar */
.fi-topbar {
    background: var(--petra-topbar-bg) !important;
    border-bottom: 1px solid var(--petra-topbar-border) !important;
    box-shadow: 0 1px 0 rgba(15, 23, 42, 0.04) !important;
}

/* Sidebar shell */
.fi-main-sidebar,
.fi-sidebar,
.fi-sidebar-header,
.fi-sidebar-nav,
.fi-sidebar-footer {
    background: var(--petra-sidebar-bg) !important;
}

/* Sidebar border separation */
.fi-main-sidebar {
    border-right: 1px solid var(--petra-sidebar-border) !important;
    box-shadow: 8px 0 24px rgba(15, 23, 42, 0.18) !important;
}

/* Sidebar header / logo area */
.fi-sidebar-header {
    border-bottom: 1px solid var(--petra-sidebar-border) !important;
    background:
        radial-gradient(circle at top left, rgba(56, 189, 248, 0.16), transparent 36%),
        var(--petra-sidebar-bg) !important;
}

/* Sidebar nav spacing */
.fi-sidebar-nav {
    padding-top: 0.75rem !important;
}

/* Sidebar group labels */
.fi-sidebar-group-label {
    color: var(--petra-sidebar-muted) !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    font-size: 0.72rem !important;
}

/* Sidebar item buttons */
.fi-sidebar-item-btn {
    border-radius: 0.75rem !important;
    color: var(--petra-sidebar-text) !important;
    transition:
        background-color 160ms ease,
        color 160ms ease,
        box-shadow 160ms ease,
        transform 160ms ease !important;
}

.fi-sidebar-item-label {
    color: var(--petra-sidebar-text) !important;
}

.fi-sidebar-item-icon {
    color: var(--petra-sidebar-muted) !important;
}

/* Sidebar hover */
.fi-sidebar-item-btn:hover {
    background: var(--petra-sidebar-bg-soft) !important;
    color: #ffffff !important;
}

.fi-sidebar-item-btn:hover .fi-sidebar-item-label,
.fi-sidebar-item-btn:hover .fi-sidebar-item-icon {
    color: #ffffff !important;
}

/* Active sidebar item */
.fi-active > .fi-sidebar-item-btn,
.fi-active > a {
    background:
        linear-gradient(90deg, var(--petra-sidebar-active-bg), rgba(56, 189, 248, 0.08)) !important;
    border-left: 3px solid var(--petra-sidebar-active-border) !important;
    color: #ffffff !important;
    box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.12) !important;
}

.fi-active > .fi-sidebar-item-btn .fi-sidebar-item-label,
.fi-active > .fi-sidebar-item-btn .fi-sidebar-item-icon,
.fi-active > a .fi-sidebar-item-label,
.fi-active > a .fi-sidebar-item-icon {
    color: #ffffff !important;
}

/* Main content cards / panels */
.fi-section,
.fi-ta-ctn,
.fi-wi-stats-overview-stat,
.fi-simple-main-ctn {
    background-color: var(--petra-content-card-bg) !important;
}

/* Better separation around page content */
.fi-main-ctn,
.fi-page {
    min-height: 100vh !important;
}

/* Keep dropdown readable */
.fi-dropdown-panel {
    border: 1px solid var(--petra-topbar-border) !important;
}

/* Mobile sidebar also follows same visual identity */
.fi-sidebar-close-overlay + .fi-main-sidebar,
.fi-sidebar-open .fi-main-sidebar {
    background: var(--petra-sidebar-bg) !important;
}
